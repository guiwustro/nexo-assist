# Postgres local (docker compose up -d db)
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo
# Banco usado por pnpm test:int (criado pelo init do compose)
DATABASE_URL_TEST=postgres://nexo:nexo@localhost:5432/nexo_test
# Segredo do cookie de sessão (mínimo 32 caracteres)
SESSION_SECRET=troque-este-segredo-por-algo-com-32-caracteres
# Endereço do serviço de chamados (pnpm dev sobe na porta 4001)
TICKETS_URL=http://localhost:4001
# Segredo compartilhado entre o app e o serviço de chamados (header x-internal-secret)
TICKETS_INTERNAL_SECRET=segredo-interno-local
# Porta do serviço de chamados
TICKETS_PORT=4001
# Probabilidade (0–1) de o serviço de chamados falhar de propósito em cada requisição
TICKETS_FAILURE_RATE=0
# Liga a rota POST /_chaos/outage para derrubar o serviço por N segundos (demo)
TICKETS_CHAOS_ENABLED=true
# deepseek = modelo real; scripted = modelo roteirizado e determinístico (testes e demo sem chave)
LLM_PROVIDER=scripted
# Modelo usado quando LLM_PROVIDER=deepseek
MODEL_ID=deepseek-flash
# Chave da DeepSeek (obrigatória só com LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
# Abaixo desta confiança declarada o agent transfere para um analista
LOW_CONFIDENCE_THRESHOLD=0.6
# Mensagens do funcionário por sessão de login; a última transfere para analista
SESSION_MESSAGE_LIMIT=30
# Preço do modelo em centavos de dólar por milhão de tokens (vazio = custo não medido).
# deepseek-flash no pico, entrada sem cache: 30 e 120 (US$ 0,30 / US$ 1,20 por milhão; api-docs.deepseek.com, nov/2026)
LLM_PRICE_IN_CENTS_PER_MTOK=
LLM_PRICE_OUT_CENTS_PER_MTOK=
# Mensagens por minuto por usuário no chat
RATE_LIMIT_PER_MINUTE=20
# Teto diário de gasto com o modelo, em centavos (vazio = sem teto)
LLM_DAILY_BUDGET_CENTS=
