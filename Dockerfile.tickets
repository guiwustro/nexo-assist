# Serviço de chamados (legado simulado). O código importa lib/contracts e lib/regras: o esbuild empacota tudo
# num arquivo só e o runner roda com node puro, sem node_modules.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY lib ./lib
COPY services ./services
RUN node_modules/.bin/esbuild services/tickets/src/server.ts --bundle --platform=node --format=esm --target=node22 \
      --outfile=dist/tickets.mjs \
      --banner:js="import { createRequire } from 'module'; const require = createRequire(import.meta.url);"

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production TICKETS_PORT=4001
COPY --from=build --chown=node:node /app/dist/tickets.mjs ./tickets.mjs
USER node
EXPOSE 4001
HEALTHCHECK --interval=10s --timeout=3s CMD wget -qO- http://127.0.0.1:4001/healthz || exit 1
CMD ["node", "tickets.mjs"]
