{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -k -n web,tickets -c blue,magenta \"next dev -p ${PORT:-3000}\" \"pnpm tickets:dev\"",
    "build": "next build",
    "start": "next start",
    "tickets:dev": "tsx watch services/tickets/src/server.ts",
    "tickets:start": "tsx services/tickets/src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "eval": "tsx evals/run.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "db:reset": "tsx lib/db/reset.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.78",
    "@ai-sdk/provider": "^4.0.35",
    "@ai-sdk/react": "^4.0.165",
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@mastra/core": "^1.81.0",
    "@mastra/memory": "^1.40.0",
    "@mastra/pg": "^1.34.0",
    "ai": "^7.0.161",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
